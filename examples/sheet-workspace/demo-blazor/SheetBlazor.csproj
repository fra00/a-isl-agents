<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SheetBlazor</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Monolithic bin-blazor: UI (.razor) + engine (.cs). No bin-csharp. -->
  <ItemGroup>
    <Compile Include="..\bin-blazor\**\*.cs" Link="BinBlazor\%(Filename)%(Extension)" />
    <RazorComponent Include="..\bin-blazor\**\*.razor" Link="BinBlazor\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
